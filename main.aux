\@writefile{toc}{\contentsline {section}{\numberline {1}Atoms in Motion}{1}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {1.1}If heat is merely molecular motion, what is the difference between a hot, stationary baseball and a cool, rapidly moving one?}{1}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {1.2}If the atoms of all objects are perpetually in motion, how can there be any permanent objects, such as fossil imprints?}{1}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {1.3}Explain qualitatively why and how friction in a moving machine produces heat. Explain also, if you can, why heat cannot produce useful motion by the reverse process.}{2}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {1.4}Chemists have found that the molecules of rubber consist of long criss-crossed chains of atoms. Explain why a rubber band becomes warm when it is stretched.}{3}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {1.5}What should happen to a rubber band which is supporting a given weight, if it is heated? (To find out, try it.)}{3}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {1.6}Can you explain why there are no crystals that have the shape of a regular pentagon? (Triangles, squares, and hexagons are common in crystal forms.)}{3}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {1.7}You are given a large number of steel balls of equal diameter d and a container of known volume V. Every dimension of the container is much greater than the diameter of a ball. What is the greatest number of balls, N, that can be placed in the container}{4}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {1.8}How should the pressure P of a gas vary with n, the number of atoms per unit volume, and (v), the average speed of an atom? (Should P be proportional to n and/ or to (v), or should it vary more, or less, rapidly than linearly?)}{4}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {1.9}Ordinary air has a density of about $0.001\text  { g\,cm}^{-3}$, while liquid air has a density of about $1.0\text  { g\,cm}^{-3}$.}{5}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {1.9.1}Estimate the number of air molecules per cm$^3$ in ordinary air, $n_G$, and in liquid air, $n_L$.}{5}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {1.9.2}Estimate the mass $m$ of an air molecule.}{6}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {1.9.3}Estimate the average distance $l$ an air molecule should travel between collisions at normal temperature and pressure (NTP, $20^\circ $C at 1 atm). This distance is called the mean free path.}{6}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {1.9.4}Estimate at what pressure $P$, in normal atmospheres, a vacuum system should be operated in order that the mean free path be about one meter.}{6}{}\protected@file@percent }
